//--- Getting input using Scanner ---
import java.util.Scanner;// Syntax for calling the 
//Input function on the variable in the module Scanner 
public class Main {
    public static void main(String[] args){
        Scanner scanner = new Scanner(System.in);
    // Reading the one word(stops at whitespace)
    System.out.print("\nEnter your city: ");
    String userCity = scanner.next(); // reads one word
    System.out.println("You live in: "+userCity);

    // Reading the full line (including spaces)
    scanner.nextLine()// clears leftover newline from previous next()
    System.out.print("\nEnter a sentence about yourself: ");
    String fullSentence = scanner.nextLine();// reads the entire line or paragraph
    System.out.println("You said: "+fullSentence);

    scanner.close();
        
    }
}


